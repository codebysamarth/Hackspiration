    bytec 7 // "total_resale_revenue"
    swap
    app_global_put
    // smart_contracts/ticket_contract/contract.py:363
    // buyer = Txn.sender
    txn Sender
    // smart_contracts/ticket_contract/contract.py:365-371
    // itxn.AssetTransfer(
