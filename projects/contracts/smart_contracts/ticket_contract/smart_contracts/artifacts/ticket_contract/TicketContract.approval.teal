    // ).submit()
    itxn_submit
    // smart_contracts/ticket_contract/contract.py:373
    // op.Box.delete(box_key)
    box_del
    pop
    retsub


// smart_contracts.ticket_contract.contract.TicketContract.mark_scanned(ticket_id: uint64) -> void:
mark_scanned:
    // smart_contracts/ticket_contract/contract.py:380-381
    // @abimethod
    // def mark_scanned(self, ticket_id: UInt64) -> None:
    proto 1 0
    // smart_contracts/ticket_contract/contract.py:383
    // assert Txn.sender == self.organizer_address, "Only event organizer can scan tickets"
    txn Sender
    intc_0 // 0
    bytec 5 // "organizer_address"
    app_global_get_ex
    assert // check self.organizer_address exists
    ==
    assert // Only event organizer can scan tickets
    // smart_contracts/ticket_contract/contract.py:385
    // box_key = Bytes(b"scanned_") + op.itob(ticket_id)
    frame_dig -1
    itob
    bytec 11 // 0x7363616e6e65645f
    swap
    concat
    // smart_contracts/ticket_contract/contract.py:386
    // existing_length, _exists = op.Box.length(box_key)
    dup
    box_len
    pop
    // smart_contracts/ticket_contract/contract.py:387
    // assert existing_length == 0, "Ticket already scanned"
    !
    assert // Ticket already scanned
    // smart_contracts/ticket_contract/contract.py:389
    // scan_timestamp = Global.latest_timestamp
    global LatestTimestamp
    // smart_contracts/ticket_contract/contract.py:390
    // op.Box.create(box_key, UInt64(8))
    dig 1
    pushint 8 // 8
    box_create
    pop
    // smart_contracts/ticket_contract/contract.py:391
    // op.Box.put(box_key, op.itob(scan_timestamp))
    itob
    box_put
    retsub


