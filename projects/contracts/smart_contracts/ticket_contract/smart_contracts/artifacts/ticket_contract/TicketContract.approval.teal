// smart_contracts.ticket_contract.contract.TicketContract.withdraw_revenue() -> uint64:
withdraw_revenue:
    // smart_contracts/ticket_contract/contract.py:413
    // assert Txn.sender == self.organizer_address, "Only organizer can withdraw"
    txn Sender
    intc_0 // 0
    bytec 5 // "organizer_address"
    app_global_get_ex
    assert // check self.organizer_address exists
    ==
    assert // Only organizer can withdraw
    // smart_contracts/ticket_contract/contract.py:414
    // assert self.event_date > UInt64(0), "No event configured"
    intc_0 // 0
    bytec_0 // "event_date"
    app_global_get_ex
    assert // check self.event_date exists
    assert // No event configured
    // smart_contracts/ticket_contract/contract.py:415
    // assert Global.latest_timestamp >= self.event_date, "Cannot withdraw before event date"
    global LatestTimestamp
    intc_0 // 0
    bytec_0 // "event_date"
    app_global_get_ex
    assert // check self.event_date exists
    >=
    assert // Cannot withdraw before event date
    // smart_contracts/ticket_contract/contract.py:417
    // min_balance = Global.current_application_address.min_balance + UInt64(100_000)
    global CurrentApplicationAddress
    acct_params_get AcctMinBalance
    assert // account funded
    pushint 100000 // 100000
    +
    // smart_contracts/ticket_contract/contract.py:418
    // app_balance = Global.current_application_address.balance
    global CurrentApplicationAddress
    acct_params_get AcctBalance
    assert // account funded
    // smart_contracts/ticket_contract/contract.py:419
    // assert app_balance > min_balance, "Insufficient balance to withdraw"
    dup
    dig 2
    >
    assert // Insufficient balance to withdraw
    // smart_contracts/ticket_contract/contract.py:421
    // withdraw_amount = app_balance - min_balance
    swap
    -
    // smart_contracts/ticket_contract/contract.py:423-427
    // itxn.Payment(
    //     receiver=self.organizer_address,
    //     amount=withdraw_amount,
    //     fee=UInt64(0)
    // ).submit()
    itxn_begin
    // smart_contracts/ticket_contract/contract.py:424
    // receiver=self.organizer_address,
    intc_0 // 0
    bytec 5 // "organizer_address"
    app_global_get_ex
    assert // check self.organizer_address exists
    dig 1
    itxn_field Amount
    itxn_field Receiver
    // smart_contracts/ticket_contract/contract.py:423
    // itxn.Payment(
    intc_1 // pay
    itxn_field TypeEnum
    // smart_contracts/ticket_contract/contract.py:426
    // fee=UInt64(0)
    intc_0 // 0
    itxn_field Fee
    // smart_contracts/ticket_contract/contract.py:423-427
    // itxn.Payment(
    //     receiver=self.organizer_address,
    //     amount=withdraw_amount,
    //     fee=UInt64(0)
    // ).submit()
    itxn_submit
    // smart_contracts/ticket_contract/contract.py:429
    // return withdraw_amount
    retsub


