    proto 1 0
    // smart_contracts/ticket_contract/contract.py:214
    // assert Txn.sender == self.organizer_address, "Only event organizer can scan tickets"
    txn Sender
    intc_0 // 0
    bytec 5 // "organizer_address"
    app_global_get_ex
    assert // check self.organizer_address exists
    ==
    assert // Only event organizer can scan tickets
